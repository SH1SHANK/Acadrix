{
  "manifest_version": 3,
  "name": "Acadrix",
  "version": "0.3.0",
  "description": "Read all questions in one view and export IITM Online Degree assessments to Markdown, PDF, or portable bundles.",
  "homepage_url": "https://github.com/civiks/unfold-iitm",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "debugger",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.study.iitm.ac.in/*",
    "*://*.onlinedegree.iitm.ac.in/*",
    "*://onlinedegree.iitm.ac.in/*",
    "*://*.iitm.ac.in/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.study.iitm.ac.in/*",
        "*://*.onlinedegree.iitm.ac.in/*",
        "*://onlinedegree.iitm.ac.in/*",
        "*://*.iitm.ac.in/*"
      ],
      "js": [
        "customize.js",
        "katex.min.js",
        "run.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "katex.min.css"
      ],
      "matches": [
        "*://*.study.iitm.ac.in/*",
        "*://*.onlinedegree.iitm.ac.in/*",
        "*://onlinedegree.iitm.ac.in/*",
        "*://*.iitm.ac.in/*"
      ]
    }
  ],
  "action": {
    "default_title": "Acadrix — All Questions",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "iitm-show-all-questions@local",
      "strict_min_version": "115.0"
    }
  }
}
